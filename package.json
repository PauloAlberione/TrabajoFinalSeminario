{
  "name": "menteclear",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "backend:dev": "node --env-file-if-exists=servidor/.env --import tsx servidor/src/principal.ts",
    "backend:build": "tsc -p servidor/tsconfig.json",
    "respaldo:crear": "node --env-file-if-exists=servidor/.env --import tsx servidor/src/tareas/respaldo.ts crear",
    "respaldo:verificar": "node --import tsx servidor/src/tareas/respaldo.ts verificar",
    "respaldo:restaurar": "node --import tsx servidor/src/tareas/respaldo.ts restaurar",
    "test": "tsx --test servidor/src/**/*.prueba.ts",
    "logs": "node --env-file-if-exists=.env --env-file-if-exists=.env.local servidor/registro-servidor.mjs",
    "format": "oxfmt"
  },
  "dependencies": {
    "express": "^5.2.1",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "google-auth-library": "10.5.0",
    "pdfkit": "^0.20.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vite": "^8.0.16"
  },
  "pnpm": {
    "overrides": {
      "@grpc/grpc-js": ">=1.13.6",
      "uuid": ">=11.1.1"
    }
  }
}
